<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".CameraTraceActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/ghostImage"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:alpha="0.3"
        android:contentDescription="Tracing reference"
        android:scaleType="fitCenter"
        tools:src="@drawable/logo" />

    <TextView
        android:id="@+id/traceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/menu_item_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="Drag · Pinch · Double-tap to reset"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.7"
            android:background="@drawable/card_btn_bg"
            android:clickable="true"
            android:contentDescription="Go back"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnTorch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.7"
            android:background="@drawable/card_btn_bg"
            android:clickable="true"
            android:contentDescription="Flashlight"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_flashlight_off" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/changeImageBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/menu_icon_bg"
                android:clickable="true"
                android:contentDescription="Change reference image"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_image"
                app:tint="#FFFFFF" />

            <SeekBar
                android:id="@+id/opacitySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="30"
                android:progressTint="#892CDC"
                android:thumbTint="#BC6FF1" />

            <ImageView
                android:id="@+id/btnLineArt"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:alpha="0.7"
                android:background="@drawable/card_btn_bg"
                android:clickable="true"
                android:contentDescription="Line art mode"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_auto_fix_high" />

            <ImageView
                android:id="@+id/btnDone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_done_bg"
                android:clickable="true"
                android:contentDescription="Save to gallery"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_save" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/shutterFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

</FrameLayout>
